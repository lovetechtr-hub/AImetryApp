<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Дополнение к сгенерированному Info.plist (GENERATE_INFOPLIST_FILE = YES) — ключи, которых нет в настройках Xcode. -->
<plist version="1.0">
<dict>
	<!-- Compose Multiplatform 1.12: без этого ключа приложение падает на старте на реальном iPhone
	     (ProMotion 120 Гц — иначе кадры ограничены 60 Гц). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Приложение всегда тёмное: системные листы, клавиатура и алерты — тоже тёмные, без белых вспышек -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- Экран запуска — цвет фона приложения (без белого кадра до первого кадра Compose) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Шифрование — только HTTPS системы (освобождено от экспортного контроля): без вопроса о шифровании на каждую сборку -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Пуши FCM/APNs: приём уведомлений в фоне -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
